<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_01_bao_mat_gian_lan" targetNamespace="https://example.edu.vn/shopee/bpmn/v25" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.24.0">
  <bpmn:message id="Msg_Start" name="Nhận cảnh báo hoặc tín hiệu bất thường" />
  <bpmn:message id="Msg_Correct" name="Yêu cầu bổ sung log/chứng cứ" />
  <bpmn:message id="Msg_Response" name="Nhận log và chứng cứ" />
  <bpmn:message id="Msg_Result" name="Thông báo kết quả cho bên liên quan" />
  <bpmn:error id="Error_Business" name="Lỗi dịch vụ khóa giao dịch" errorCode="BUSINESS_ERROR" />
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Shopee" name="Shopee - Quản lý kiểm soát bảo mật và gian lận" processRef="Process_Shopee" />
    <bpmn:participant id="Participant_Ext_1" name="Người dùng" />
    <bpmn:participant id="Participant_Ext_2" name="Người bán" />
    <bpmn:messageFlow id="mf_start" sourceRef="Participant_Ext_1" targetRef="start" messageRef="Msg_Start" />
    <bpmn:messageFlow id="mf_correct" sourceRef="correct" targetRef="Participant_Ext_1" messageRef="Msg_Correct" />
    <bpmn:messageFlow id="mf_response" sourceRef="Participant_Ext_2" targetRef="response" messageRef="Msg_Response" />
    <bpmn:messageFlow id="mf_result_1" sourceRef="notify" targetRef="Participant_Ext_1" messageRef="Msg_Result" />
    <bpmn:messageFlow id="mf_result_2" sourceRef="notify" targetRef="Participant_Ext_2" messageRef="Msg_Result" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Shopee" name="Quản lý kiểm soát bảo mật và gian lận" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_3" name="Quản lý rủi ro">
        <bpmn:flowNodeRef>pd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alternative</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Đội An toàn thông tin">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>optional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>err</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Hệ thống Shopee">
        <bpmn:flowNodeRef>correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>geb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>escalate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>capture</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>error_task</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>error_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timeout_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bt</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="review" name="Phân tích chuyên sâu và chấm điểm rủi ro" />
    <bpmn:businessRuleTask id="optional" name="Đối chiếu thiết bị và lịch sử">
      <bpmn:outgoing>Flow_0smvvxz</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="pd" name="Bảo toàn log và chứng cứ" />
    <bpmn:parallelGateway id="g7" name="" />
    <bpmn:exclusiveGateway id="g8" name="Có xác nhận gian lận?" default="f25" />
    <bpmn:userTask id="alternative" name="Gỡ cảnh báo và tăng cường giám sát" />
    <bpmn:exclusiveGateway id="g9" name="" />
    <bpmn:sendTask id="correct" name="Yêu cầu bổ sung log/&#10;chứng cứ" messageRef="Msg_Correct" />
    <bpmn:eventBasedGateway id="geb" name="" />
    <bpmn:userTask id="escalate" name="Nhắc việc/chuyển cấp xử lý" />
    <bpmn:intermediateCatchEvent id="response" name="">
      <bpmn:messageEventDefinition id="ResponseMessageDef" messageRef="Msg_Response" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="wait" name="">
      <bpmn:timerEventDefinition id="WaitTimerDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g2" name="" />
    <bpmn:dataObjectReference id="data_in" name="Hồ sơ cảnh báo đầu vào" dataObjectRef="DataObject_1" />
    <bpmn:exclusiveGateway id="g1" name="Dữ liệu cảnh báo đủ và hợp lệ?" default="f04" />
    <bpmn:userTask id="capture" name="Ghi nhận, phân loại và kiểm tra đầu vào" />
    <bpmn:startEvent id="start" name="">
      <bpmn:messageEventDefinition id="StartMessageDef" messageRef="Msg_Start" />
    </bpmn:startEvent>
    <bpmn:inclusiveGateway id="g4" name="" />
    <bpmn:inclusiveGateway id="g5" name="">
      <bpmn:incoming>Flow_0smvvxz</bpmn:incoming>
    </bpmn:inclusiveGateway>
    <bpmn:userTask id="error_task" name="Lỗi dịch vụ khóa giao dịch" />
    <bpmn:endEvent id="error_end" name="Kết thúc lỗi">
      <bpmn:terminateEventDefinition id="ErrorTerminateDef" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="success" name="Khóa giao dịch, lập hồ sơ xử lý">
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1dod8zp">
        <bpmn:targetRef>data_out</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataObjectReference id="data_out" name="Hồ sơ cảnh báo kết quả" dataObjectRef="DataObject_1" />
    <bpmn:dataObject id="DataObject_1" name="Hồ sơ cảnh báo" />
    <bpmn:userTask id="pc" name="Khoanh vùng tài khoản/giao dịch" />
    <bpmn:parallelGateway id="g6" name="" />
    <bpmn:sendTask id="notify" name="Thông báo kết quả cho bên liên quan" messageRef="Msg_Result" />
    <bpmn:endEvent id="end" name="Hoàn tất" />
    <bpmn:endEvent id="timeout_end" name="Quá hạn 2 ngày – dừng">
      <bpmn:terminateEventDefinition id="TimeoutTerminateDef" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="g3" name="" />
    <bpmn:boundaryEvent id="err" name="Lỗi" attachedToRef="success">
      <bpmn:errorEventDefinition id="BoundaryErrorDef" errorRef="Error_Business" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="bt" name="" attachedToRef="correct">
      <bpmn:outgoing>f06</bpmn:outgoing>
      <bpmn:outgoing>f05</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_12hcrsh">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="f14" name="Bắt buộc" sourceRef="g4" targetRef="review">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f16" sourceRef="review" targetRef="g5" />
    <bpmn:sequenceFlow id="f15" name="Bổ sung" sourceRef="g4" targetRef="optional">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${needExtraReview}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0smvvxz" sourceRef="optional" targetRef="g5" />
    <bpmn:sequenceFlow id="f20" sourceRef="g6" targetRef="pd" />
    <bpmn:sequenceFlow id="f22" sourceRef="pd" targetRef="g7" />
    <bpmn:sequenceFlow id="f21" sourceRef="pc" targetRef="g7" />
    <bpmn:sequenceFlow id="f23" sourceRef="g7" targetRef="g8" />
    <bpmn:sequenceFlow id="f24" name="Đạt" sourceRef="g8" targetRef="success">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${resultOk}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f25" name="Ngoại lệ" sourceRef="g8" targetRef="alternative" />
    <bpmn:sequenceFlow id="f27" sourceRef="alternative" targetRef="g9" />
    <bpmn:sequenceFlow id="f26" sourceRef="success" targetRef="g9" />
    <bpmn:sequenceFlow id="f30" sourceRef="g9" targetRef="notify" />
    <bpmn:sequenceFlow id="f04" name="Thiếu/sai" sourceRef="g1" targetRef="correct" />
    <bpmn:sequenceFlow id="f07" sourceRef="g2" targetRef="geb" />
    <bpmn:sequenceFlow id="f08" name="Có phản hồi" sourceRef="geb" targetRef="response" />
    <bpmn:sequenceFlow id="f09" name="Timeout" sourceRef="geb" targetRef="wait" />
    <bpmn:sequenceFlow id="f11" sourceRef="wait" targetRef="escalate" />
    <bpmn:sequenceFlow id="f12" sourceRef="escalate" targetRef="g3" />
    <bpmn:sequenceFlow id="f10" sourceRef="response" targetRef="g3" />
    <bpmn:sequenceFlow id="f03" name="Hợp lệ" sourceRef="g1" targetRef="g2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${inputValid}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f05" sourceRef="bt" targetRef="g2" />
    <bpmn:sequenceFlow id="f02" sourceRef="capture" targetRef="g1" />
    <bpmn:sequenceFlow id="f01" sourceRef="start" targetRef="capture" />
    <bpmn:sequenceFlow id="f13" sourceRef="g3" targetRef="g4" />
    <bpmn:sequenceFlow id="f18" sourceRef="g5" targetRef="g6" />
    <bpmn:sequenceFlow id="f28" sourceRef="err" targetRef="error_task" />
    <bpmn:sequenceFlow id="f29" sourceRef="error_task" targetRef="error_end" />
    <bpmn:sequenceFlow id="f19" sourceRef="g6" targetRef="pc" />
    <bpmn:sequenceFlow id="f31" sourceRef="notify" targetRef="end" />
    <bpmn:sequenceFlow id="f06" sourceRef="bt" targetRef="timeout_end" />
    <bpmn:association id="Assoc_Input" associationDirection="One" sourceRef="data_in" targetRef="capture" />
  </bpmn:process>
