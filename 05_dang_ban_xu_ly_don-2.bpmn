    <bpmn:messageFlow id="mf_correct" sourceRef="correct" targetRef="Participant_Ext_1" messageRef="Msg_Correct" />
    <bpmn:messageFlow id="mf_response" sourceRef="Participant_Ext_2" targetRef="response" messageRef="Msg_Response" />
    <bpmn:messageFlow id="mf_result_1" sourceRef="notify" targetRef="Participant_Ext_1" messageRef="Msg_Result" />
    <bpmn:messageFlow id="mf_result_2" sourceRef="notify" targetRef="Participant_Ext_2" messageRef="Msg_Result" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Shopee" name="Người bán đăng bán và xử lý đơn hàng" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_3" name="Vận hành đơn">
        <bpmn:flowNodeRef>pd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>alternative</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Kiểm duyệt Shopee">
        <bpmn:flowNodeRef>g7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>optional</bpmn:flowNodeRef>
