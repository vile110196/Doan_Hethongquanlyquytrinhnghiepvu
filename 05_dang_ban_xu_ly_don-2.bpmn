<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_05_dang_ban_xu_ly_don" targetNamespace="https://example.edu.vn/shopee/bpmn/v25" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.24.0">
  <bpmn:message id="Msg_Start" name="Người bán gửi sản phẩm hoặc nhận đơn mới" />
  <bpmn:message id="Msg_Correct" name="Yêu cầu người bán chỉnh sửa" />
  <bpmn:message id="Msg_Response" name="Nhận bản chỉnh sửa" />
  <bpmn:message id="Msg_Result" name="Thông báo trạng thái cho người bán" />
  <bpmn:error id="Error_Business" name="Lỗi đăng bán hoặc bàn giao" errorCode="BUSINESS_ERROR" />
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Shopee" name="Shopee - Người bán đăng bán và xử lý đơn hàng" processRef="Process_Shopee" />
    <bpmn:participant id="Participant_Ext_1" name="Người bán" />
