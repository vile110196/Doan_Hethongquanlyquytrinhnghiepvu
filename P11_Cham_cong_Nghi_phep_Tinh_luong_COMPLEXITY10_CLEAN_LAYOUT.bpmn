    <bpmn:exclusiveGateway id="G2" name="Duyệt điều chỉnh?" gatewayDirection="Diverging"/>
    <bpmn:task id="D" name="Trả lại yêu cầu / bổ sung"/>
    <bpmn:task id="H" name="Phê duyệt hoặc từ chối đơn"/>
    <bpmn:exclusiveGateway id="G4" name="Đơn được duyệt?" gatewayDirection="Diverging"/>
    <bpmn:exclusiveGateway id="G8" name="Bảng lương duyệt?" gatewayDirection="Diverging"/>
    <bpmn:task id="Q" name="Trả lại bảng lương"/>
