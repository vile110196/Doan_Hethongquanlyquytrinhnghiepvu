      <bpmn:lane id="P11_Lane_hr" name="HR / C&amp;B">
        <bpmn:flowNodeRef>E</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F</bpmn:flowNodeRef>
