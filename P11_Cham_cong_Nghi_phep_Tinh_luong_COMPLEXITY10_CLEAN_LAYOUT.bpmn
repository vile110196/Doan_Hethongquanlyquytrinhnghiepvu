        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P11_Lane_manager" name="Quản lý / Người phê duyệt">
        <bpmn:flowNodeRef>C</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D</bpmn:flowNodeRef>
