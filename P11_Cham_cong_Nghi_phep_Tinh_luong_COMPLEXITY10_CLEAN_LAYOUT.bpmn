      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Bắt đầu"/>
    <bpmn:task id="A" name="Ghi nhận chấm công"/>
    <bpmn:exclusiveGateway id="G1" name="Chấm công hợp lệ?" gatewayDirection="Diverging"/>
    <bpmn:task id="B" name="Gửi yêu cầu điều chỉnh"/>
    <bpmn:task id="X" name="Kiểm tra phiếu lương"/>
