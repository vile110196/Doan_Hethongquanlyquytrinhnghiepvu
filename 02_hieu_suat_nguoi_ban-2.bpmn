  <bpmn:message id="Msg_Start" name="Đến kỳ đánh giá hoặc nhận cảnh báo KPI" />
  <bpmn:message id="Msg_Correct" name="Yêu cầu đối soát/bổ sung dữ liệu" />
  <bpmn:message id="Msg_Response" name="Nhận phản hồi KPI" />
