    <bpmn:exclusiveGateway id="g1" name="Dữ liệu KPI đủ và đáng tin cậy?" default="f04" />
    <bpmn:sendTask id="correct" name="Yêu cầu đối soát/&#10;bổ sung dữ liệu" messageRef="Msg_Correct" />
    <bpmn:endEvent id="timeout_end" name="Quá hạn 2 ngày – dừng">
      <bpmn:terminateEventDefinition id="TimeoutTerminateDef" />
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="err" name="Lỗi" attachedToRef="success">
