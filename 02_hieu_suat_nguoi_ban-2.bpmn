    <bpmn:userTask id="escalate" name="Nhắc việc/chuyển cấp xử lý" />
    <bpmn:intermediateCatchEvent id="wait" name="">
      <bpmn:timerEventDefinition id="WaitTimerDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="pc" name="Tính điểm hiệu suất" />
    <bpmn:parallelGateway id="g7" name="" />
    <bpmn:exclusiveGateway id="g8" name="Người bán đạt chuẩn?" default="f25" />
    <bpmn:userTask id="alternative" name="Áp dụng kế hoạch cải thiện/chế tài" />
    <bpmn:serviceTask id="success" name="Duy trì quyền lợi và xếp hạng">
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0w0wwu9">
        <bpmn:targetRef>data_out</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sendTask id="notify" name="Gửi kết quả đánh giá cho người bán" messageRef="Msg_Result" />
    <bpmn:endEvent id="end" name="Hoàn tất" />
    <bpmn:dataObjectReference id="data_out" name="Hồ sơ KPI người bán kết quả" dataObjectRef="DataObject_1" />
