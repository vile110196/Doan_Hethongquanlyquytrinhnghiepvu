    <bpmn:messageFlow id="mf_result_2" sourceRef="notify" targetRef="Participant_Ext_2" messageRef="Msg_Result" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Shopee" name="Quản lý hiệu suất và chất lượng người bán" isExecutable="false">
